# Zabbix Agent 2 — пример для Windows / Linux (active + passive)

### Option: Hostname
# Должно совпадать с Host name в Zabbix UI
Hostname=REPLACE_HOSTNAME

### Option: Server
# IP/DNS Zabbix server или proxy (для passive checks, порт 10050 на агенте)
Server=REPLACE_ZABBIX_SERVER

### Option: ServerActive
# Туда агент отправляет active checks (порт 10051 на сервере)
ServerActive=REPLACE_ZABBIX_SERVER

### Option: ListenPort
ListenPort=10050

### Option: Timeout
Timeout=10

### Option: LogFile
# Windows: C:\Program Files\Zabbix Agent 2\zabbix_agent2.log
# Linux:   /var/log/zabbix/zabbix_agent2.log
# LogFile=...

### Option: ControlSocket (Linux)
# ControlSocket=/tmp/agent.sock

### Option: Include
# Windows: Include=C:\Program Files\Zabbix Agent 2\zabbix_agent2.d\*.conf
# Linux:   Include=/etc/zabbix/zabbix_agent2.d/*.conf

### Option: HostMetadata (опционально для autoregistration)
# HostMetadata=windows,server,netmon

### Option: TLSConnect / TLSPSK* (рекомендуется в production)
# TLSConnect=psk
# TLSAccept=psk
# TLSPSKIdentity=netmon-agent
# TLSPSKFile=C:\Program Files\Zabbix Agent 2\psk.key
