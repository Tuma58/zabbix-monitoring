# Images are pinned to a Zabbix LTS release line. Pin digests before production.
ZABBIX_VERSION=7.0-alpine-latest
POSTGRES_VERSION=16-alpine

POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-me

PHP_TZ=Europe/Moscow
ZABBIX_WEB_BIND=127.0.0.1
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8081

# Tune after measuring NVPS during the pilot.
ZBX_CACHESIZE=128M
ZBX_HISTORYCACHESIZE=64M
ZBX_TRENDCACHESIZE=32M
ZBX_VALUECACHESIZE=128M
